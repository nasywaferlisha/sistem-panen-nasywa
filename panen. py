hasil_panen = [10, 15, 20, 12]
total_panen = sum(hasil_panen)

def hitung_diskon(total, persen):
    diskon = total * persen / 100
    return total - diskon

persen_diskon = 10
total_setelah_diskon = hitung_diskon(total_panen, persen_diskon)

print("Hasil panen:", hasil_panen)
print("Total hasil panen:", total_panen, "kg")
print("Diskon:", persen_diskon, "%")
print("Total setelah diskon:", total_setelah_diskon, "kg")
