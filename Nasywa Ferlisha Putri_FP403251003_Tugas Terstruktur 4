        "%%writefile panen.py\n",
        "hasil_panen = [10, 15, 20, 12]\n",
        "total_panen = sum(hasil_panen)\n",
        "\n",
        "def hitung_diskon(total, persen):\n",
        "    diskon = total * persen / 100\n",
        "    return total - diskon\n",
        "\n",
        "persen_diskon = 10\n",
        "total_setelah_diskon = hitung_diskon(total_panen, persen_diskon)\n",
        "\n",
        "print(\"Hasil panen:\", hasil_panen)\n",
        "print(\"Total hasil panen:\", total_panen, \"kg\")\n",
        "print(\"Diskon:\", persen_diskon, \"%\")\n",
        "print(\"Total setelah diskon:\", total_setelah_diskon, \"kg\")"
